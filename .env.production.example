# Upload a completed copy as Jenkins Secret file: laundry-production-env.
# Do not commit the completed file. Keep APP_KEY and DB_PASSWORD across deploys.
APP_NAME="AA Laundry"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://laundry.bits.my.id
# The host cloudflared process reaches Nginx through the Docker bridge gateway.
# Only the forwarded protocol is trusted, not forwarded host/client-IP headers.
TRUSTED_PROXIES=172.16.0.0/12
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
HTTP_PORT=8088

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=laundry
DB_USERNAME=laundry
# Use an unquoted hex password; the preflight Docker client reads this file too.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
LOG_CHANNEL=stderr
LOG_LEVEL=info
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Enable after filling in sandbox credentials and a reachable callback URL.
TRIPAY_ENABLED=false
TRIPAY_MODE=sandbox
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_CALLBACK_URL=
TRIPAY_EXPIRY_MINUTES=60
TRIPAY_TIMEOUT=15
